---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import TagList from '../components/TagList.astro';
import { SITE_WELCOME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) =>
	a.localeCompare(b),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
      <h1 class="welcome">{SITE_WELCOME}</h1>
			<p class="intro">{SITE_DESCRIPTION}</p>
			<nav class="filter" aria-label="Filtrar posts por tag">
				<label class="filter-label" for="tag-filter">Filtrar um post por tag</label>
				<div class="filter-field">
					<svg
						class="filter-icon"
						viewBox="0 0 24 24"
						aria-hidden="true"
						width="16"
						height="16"
					>
						<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"
						></circle>
						<path
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							d="m20 20-3.5-3.5"></path>
					</svg>
					<input
						id="tag-filter"
						class="filter-input"
						type="search"
						placeholder="Digite uma tag…"
						autocomplete="off"
						spellcheck="false"
					/>
					<kbd class="filter-kbd" aria-hidden="true">/</kbd>
				</div>
				<p id="filter-count" class="filter-count" aria-live="polite"></p>
				<TagList tags={allTags} />
			</nav>
			<section>
				<PostList posts={posts} />
				<p id="no-results" class="no-results" hidden>Nenhum post encontrado com essa tag.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.welcome {
		margin-bottom: 0.25em;
		font-size: 2.4em;
	}
	.intro {
		max-width: 34em;
		margin-bottom: 0;
		font-size: 1.05em;
		color: var(--text-muted);
	}
	.filter {
		margin-top: 2em;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}
	.filter-label {
		display: block;
		margin-bottom: 0.35em;
		font-size: 0.85em;
		color: var(--text-muted);
	}
	.filter-field {
		position: relative;
		margin-bottom: 1em;
	}
	.filter-icon {
		position: absolute;
		top: 50%;
		left: 0.8em;
		transform: translateY(-50%);
		color: var(--text-muted);
		pointer-events: none;
	}
	.filter-input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.65em 2.4em 0.65em 2.3em;
		font: inherit;
		color: var(--text);
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	.filter-input::placeholder {
		color: var(--text-muted);
	}
	/* Esconde o "x" nativo do type=search: o Esc já limpa o campo */
	.filter-input::-webkit-search-cancel-button {
		display: none;
	}
	.filter-kbd {
		position: absolute;
		top: 50%;
		right: 0.8em;
		transform: translateY(-50%);
		padding: 0.1em 0.5em;
		font-family: inherit;
		font-size: 0.75em;
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 4px;
		pointer-events: none;
	}
	.filter-input:focus ~ .filter-kbd,
	.filter-input:not(:placeholder-shown) ~ .filter-kbd {
		display: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.filter-input {
			transition: border-color 0.15s ease;
		}
	}
	.filter-input:focus-visible {
		border-color: var(--text);
		outline: none;
	}
	/* Chip da tag que corresponde exatamente ao filtro ativo */
	.filter :global(.tag-list a.active) {
		color: var(--text);
		border-color: var(--text);
	}
	.filter-count {
		margin: -0.5em 0 1em;
		font-size: 0.85em;
		color: var(--text-muted);
	}
	.filter-count:empty {
		margin: 0;
	}
	.no-results {
		padding: 1.25em 0;
		color: var(--text-muted);
	}
</style>

<script>
	const input = document.querySelector<HTMLInputElement>('#tag-filter');
	const items = document.querySelectorAll<HTMLLIElement>('.post-list > li');
	const count = document.querySelector<HTMLElement>('#filter-count');
	const noResults = document.querySelector<HTMLElement>('#no-results');
	const chips = document.querySelectorAll<HTMLAnchorElement>('.filter .tag-list a');

	function applyFilter() {
		const query = input!.value.trim().toLowerCase();
		let visible = 0;
		for (const item of items) {
			const tags = (item.dataset.tags ?? '').split(' ');
			const match = !query || tags.some((tag) => tag.toLowerCase().includes(query));
			item.hidden = !match;
			if (match) visible++;
		}
		for (const chip of chips) {
			const tag = chip.textContent?.replace(/^#/, '').toLowerCase();
			chip.classList.toggle('active', !!query && tag === query);
		}
		if (noResults) noResults.hidden = visible > 0;
		if (count) count.textContent = query ? `${visible} ${visible === 1 ? 'post' : 'posts'}` : '';
	}

	input?.addEventListener('input', applyFilter);

	// Atalhos: "/" foca o campo de qualquer lugar; Esc limpa e tira o foco.
	document.addEventListener('keydown', (event) => {
		if (event.key === '/' && document.activeElement !== input) {
			event.preventDefault();
			input?.focus();
		}
	});
	input?.addEventListener('keydown', (event) => {
		if (event.key === 'Escape') {
			input.value = '';
			applyFilter();
			input.blur();
		}
	});

	// Clicar num chip preenche o filtro; sem JS, o chip continua sendo um link para /tags/<tag>/.
	for (const chip of chips) {
		chip.addEventListener('click', (event) => {
			event.preventDefault();
			if (!input) return;
			const tag = chip.textContent?.replace(/^#/, '') ?? '';
			input.value = input.value.trim().toLowerCase() === tag.toLowerCase() ? '' : tag;
			applyFilter();
			input.focus();
		});
	}
</script>
