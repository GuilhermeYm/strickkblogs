---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// BASE_URL pode vir sem barra final (ex.: '/strickkblogs'); normalizamos para montar os links.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pathname = Astro.url.pathname.slice(base.length - 1).replace(/\/$/, '') || '/';
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
const fullHref = String(href).replace(/^\//, base);
---

<a href={fullHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		padding: 1em 0.5em;
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
	}
	@media (prefers-reduced-motion: no-preference) {
		a {
			transition: color 0.15s ease;
		}
	}
	a.active {
		color: var(--text);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
</style>
