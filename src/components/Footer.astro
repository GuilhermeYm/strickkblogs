---
const today = new Date();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer>
	<nav class="footer-links" aria-label="Rodapé">
		<a href={base}>Início</a>
		<a href={`${base}arquivos/`}>Arquivos</a>
		<a href={`${base}about/`}>Sobre</a>
		<a href={`${base}rss.xml`}>RSS</a>
	</nav>
	<p>&copy; {today.getFullYear()} strickkblogs. Todos os direitos reservados.</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 3em;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.85em;
		text-align: center;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-bottom: 1em;
	}
	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--text);
	}
	@media (prefers-reduced-motion: no-preference) {
		.footer-links a {
			transition: color 0.15s ease;
		}
	}
	p {
		margin: 0;
	}
</style>
